# ==========================================================================
# Kiro-API V2 — .env
#
# Copy to `.env`:  cp .env.example .env
#
# WHY THIS FILE EXISTS
# --------------------
# You do NOT need this file just to run on defaults — the compose files already
# fall back to sensible defaults for every value (port 8787, dashboard 8788,
# concurrency 8, no auth, etc.). Running `docker compose up -d` with no .env
# works fine.
#
# This file is the PERSISTENCE LAYER for two things:
#   1. Per-machine host paths (where kiro-cli + credentials live) — these differ
#      per box, so they can't be baked into compose.
#   2. Values the TRAY changes at runtime. When you click "Change Port…",
#      "Change Address…", or set an API key, the tray writes the new value HERE
#      and restarts the container, so your choice survives restarts. Without a
#      .env, those changes would snap back to defaults on the next `up`.
#
# All tuning defaults (concurrency, timeouts, queue) live inline in the compose
# files. Uncomment a line below only if you want to override a default here.
# ==========================================================================

# ---- Per-machine host paths (SET THESE) ----------------------------------
# Standard config mounts the host kiro-cli binary read-only into the container.
HOST_KIRO_CLI_BIN=/usr/local/bin/kiro-cli
# kiro-cli credentials/config. VERIFY the real path on your workspace:
#   ls -la ~/.kiro ~/.aws
HOST_KIRO_CONFIG_DIR=${HOME}/.kiro
HOST_AWS_DIR=${HOME}/.aws

# ---- Tray-managed values (written by the tray; edit here to preset) -------
# The /v1 API port. Changed by the tray "Change Port…" action.
KIRO_API_PORT=8787
# Dashboard port.
KIRO_DASHBOARD_PORT=8788
# Address advertised to clients / shown in the dashboard + tray.
# Changed by the tray "Change Address…" action.
KIRO_API_ADVERTISED_HOST=localhost
# Bridge auth key. Empty = no auth (default). Set by the tray "Auth" menu.
KIRO_API_AUTH_KEY=

# ==========================================================================
# OPTIONAL OVERRIDES — uncomment only to change a compose default.
# ==========================================================================
# Concurrency (tune for the 50+ agent workload):
# KIRO_API_MAX_CONCURRENCY=8
# KIRO_API_MAX_QUEUE=0
# KIRO_API_REJECT_WHEN_BUSY=false
#
# Timeout tiers (seconds):
# KIRO_API_TIMEOUT_SHORT=120
# KIRO_API_TIMEOUT_LONG=900
#
# Model + base image:
# KIRO_API_DEFAULT_MODEL=auto
# PYTHON_IMAGE=python:3.12-slim
# OFFLINE=0
