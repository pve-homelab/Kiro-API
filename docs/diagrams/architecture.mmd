flowchart TB
    subgraph HOST["Ubuntu Workspace Host (airgapped)"]
        direction TB
        TRAY["kiro-tray agent<br/>(pystray + tkinter)<br/>ghost icon + status dot"]
        CLI["kiro-cli binary<br/>+ credentials (~/.kiro, ~/.aws)"]
        BROWSER["Browser<br/>(dashboard)"]
        APPS["Your apps / 50+ agents<br/>ohmypi -> herdr.dev"]
    end

    subgraph DOCKER["Docker: kiro-api container"]
        direction TB
        API["FastAPI service<br/>/v1/* on :8787"]
        DASH["Dashboard<br/>/ on :8788"]
        POOL["Concurrency pool<br/>semaphore + queue"]
        REAP["Reaper janitor<br/>zombie reap + GC + leak watch"]
        ADMIN["Admin API<br/>/admin/login /admin/auth-key"]
    end

    APPS -->|"OpenAI /v1 requests"| API
    API --> POOL
    POOL -->|"spawn kiro-cli chat --no-interactive"| CLI
    REAP -.->|"monitors + reaps"| POOL
    API --> DASH
    BROWSER -->|":8788"| DASH

    TRAY -->|"poll /health"| API
    TRAY -->|"docker compose up -d (restart)"| DOCKER
    TRAY -->|"trigger login / set auth"| ADMIN
    ADMIN -->|"kiro-cli login"| CLI

    CLI -.->|"mounted read-only"| DOCKER
