# syntax=docker/dockerfile:1
# Test image: app + dev deps baked in, so the suite runs fast and repeatably.
# Used by scripts/run_tests.sh and (optionally) CI.
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1
WORKDIR /proj
COPY app/requirements.txt requirements-dev.txt ./
RUN pip install -r requirements.txt -r requirements-dev.txt
# Source is bind-mounted at run time so edits don't require a rebuild.
CMD ["pytest"]
