# syntax=docker/dockerfile:1
# ===========================================================================
# Kiro-API V2 — BUNDLE image (airgapped-friendly).
#
# Single self-contained image: FastAPI service + Python deps + a kiro-cli
# binary baked in. For airgapped hosts you pull/`docker load` ONE image
# instead of assembling multiple.
#
# kiro-cli source of truth:
#   - Provide the real binary at build context path: vendor/kiro-cli
#     (copied to /usr/local/bin/kiro-cli).
#   - If absent, the offline test stub is baked in so the image still runs
#     end-to-end for validation. Replace it with the real binary for prod.
#
# Credentials are STILL mounted at runtime (never baked into the image).
# ===========================================================================
ARG PYTHON_IMAGE=python:3.12-slim
FROM ${PYTHON_IMAGE}

LABEL org.opencontainers.image.title="Kiro-API V2 (bundle)" \
      org.opencontainers.image.description="Self-contained OpenAI-compatible /v1 API + kiro-cli" \
      org.opencontainers.image.version="2.0.0"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    KIRO_CLI_BIN=/usr/local/bin/kiro-cli

RUN groupadd --gid 10001 kiro \
 && useradd --uid 10001 --gid kiro --create-home --shell /usr/sbin/nologin kiro

WORKDIR /srv

ARG OFFLINE=0
COPY app/requirements.txt /srv/app/requirements.txt
COPY wheelhouse* /srv/wheelhouse
RUN if [ "$OFFLINE" = "1" ]; then \
        pip install --no-index --find-links=/srv/wheelhouse -r /srv/app/requirements.txt ; \
    else \
        pip install -r /srv/app/requirements.txt ; \
    fi \
 && rm -rf /srv/wheelhouse

# --- kiro-cli (real binary if provided, else the stub) ---------------------
# Both paths are optional in the build context; the shell picks whichever
# exists. `vendor/.keep` / `scripts/.keep` keep COPY from failing on absence.
COPY vendor* /srv/vendor
COPY scripts/kiro-cli-stub.sh /srv/scripts/kiro-cli-stub.sh
RUN if [ -f /srv/vendor/kiro-cli ]; then \
        install -m 0755 /srv/vendor/kiro-cli /usr/local/bin/kiro-cli ; \
        echo "Baked in real kiro-cli binary." ; \
    else \
        install -m 0755 /srv/scripts/kiro-cli-stub.sh /usr/local/bin/kiro-cli ; \
        echo "WARNING: baked in kiro-cli STUB (replace with real binary for prod)." ; \
    fi \
 && rm -rf /srv/vendor

COPY app /srv/app

RUN mkdir -p /work && chown -R kiro:kiro /work /srv

USER kiro
EXPOSE 8787 8788

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python3 -c "import urllib.request,os,sys; \
url='http://127.0.0.1:'+os.environ.get('KIRO_API_PORT','8787')+'/health'; \
sys.exit(0 if urllib.request.urlopen(url, timeout=3).status==200 else 1)" || exit 1

ENTRYPOINT ["python3", "-m", "app.server"]
